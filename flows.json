    {
        "id": "08e14acc37176ac4",
        "type": "function",
        "z": "3ccd9a456c4e6bbe",
        "name": "Potencia Máxima",
        "func": "let arraycsv = msg.payload;\nlet columna = env.get(\"Columna\");\nlet nmro_registros = arraycsv.length;\n\nmsg.index = nmro_registros;\n\nflow.set(\"valor_maximo\", arraycsv[0][columna]);\n\nfor (let i = 0; i < nmro_registros; i++) {\n    if (flow.get(\"valor_maximo\") < arraycsv[i][columna]) {\n        flow.set(\"valor_maximo\", arraycsv[i][columna]);\n    }\n}\n\nmsg.payload = flow.get(\"valor_maximo\");\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1020,
        "y": 240,
